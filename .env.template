# FortiGate Configuration
# Copy this file to .env and fill in your values

FORTIGATE_HOST=192.168.1.1
FORTIGATE_TOKEN=your-api-token-here
FORTIGATE_VDOM=root
FORTIGATE_VERIFY_SSL=false

# Optional: where logs are stored on your device (disk | memory | forticloud).
# Leave unset to auto-detect (tries disk, then memory, then forticloud).
# Set explicitly if your model logs only to memory (e.g. diskless units).
# FORTIGATE_LOG_SOURCE=memory

# Ollama LLM server URL. Local default shown; point at a remote host if needed.
OLLAMA_BASE_URL=http://localhost:11434
